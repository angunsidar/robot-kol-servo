  <joint name="tutucu_ayna" type="prismatic">
    <parent link="tutucu_govde"/>
    <child link="parmak_sol"/>
    <origin xyz="0 0 0.0645" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.035" upper="-0.0005" effort="0.11768" velocity="0.05"/>
    <mimic joint="tutucu" multiplier="-1" offset="0"/>
  </joint>

  <link name="uc"/>
  <joint name="uc_sabit" type="fixed">
    <parent link="tutucu_govde"/>
    <child link="uc"/>
    <origin xyz="0 0 0.095" rpy="0 0 0"/>
  </joint>

</robot>
