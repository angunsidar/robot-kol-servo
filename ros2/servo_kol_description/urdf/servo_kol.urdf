<?xml version="1.0"?>
<!-- urdf_uret.py ile üretildi; elle düzenleme. Ölçü ve kütleler TAHMİN. -->
<robot name="servo_kol">
  <material name="mavi"><color rgba="0.12 0.37 0.75 1"/></material>
  <material name="gri"><color rgba="0.73 0.76 0.78 1"/></material>
  <material name="beyaz"><color rgba="0.94 0.94 0.94 1"/></material>
  <material name="turuncu"><color rgba="0.85 0.4 0.1 1"/></material>

  <link name="taban">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.06"/></geometry>
      <material name="gri"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.11 0.11 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000261667" ixy="0" ixz="0" iyy="0.000261667" iyz="0" izz="0.000403333"/>
    </inertial>
  </link>

  <joint name="j1_govde" type="revolute">
    <parent link="taban"/>
    <child link="govde"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="0.921825" velocity="1.16355"/>
  </joint>

  <link name="govde">
    <visual>
      <origin xyz="0 0 0.078" rpy="0 0 0"/>
