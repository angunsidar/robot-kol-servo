      <mass value="0.105"/>
      <inertia ixx="3.5315e-05" ixy="0" ixz="0" iyy="2.1875e-05" iyz="0" izz="4.144e-05"/>
    </inertial>
  </link>

  <joint name="j2_omuz" type="revolute">
